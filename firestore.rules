rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // GLOBAL FORTRESS WALL: DEFAULT DENY ALL
    // Hacker Defense: Any document or path not explicitly granted is blocked.
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // SECURITY HELPER FUNCTIONS
    // =========================================================================
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isCreator() {
      return isSignedIn()
        && request.auth.token.email == "franklinkyleluzano@gmail.com";
    }

    function isApprovedSchool(schoolId) {
      return exists(/databases/$(database)/documents/schools/$(schoolId))
        && get(/databases/$(database)/documents/schools/$(schoolId)).data.status == "approved";
    }

    function userBelongsToSchool(schoolId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == schoolId;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidTag(tag) {
      return tag in [
        "Confessions",
        "Shoutouts",
        "ngl / tbh / fr",
        "Rants & Vent",
        "Questions & Curious",
        "Appreciation"
      ];
    }

    // =========================================================================
    // 1. USERS COLLECTION
    // Protection against account hijacking, role escalation, and profile spoofing
    // =========================================================================
    match /users/{userId} {
      // Authenticated scholars can view profiles (needed for school feed avatars and names)
      allow read: if isSignedIn();

      // Account Creation Security:
      // - Must match caller's Auth UID
      // - Role must default to 'student' (cannot self-assign creator role)
      // - Nickname strictly verified when isAnonymous / Compelled mode is active
      allow create: if isOwner(userId)
        && request.resource.data.id == userId
        && (request.resource.data.role == "student" || isCreator())
        && isValidString(request.resource.data.name, 1, 100)
        && request.resource.data.isAnonymous is bool
        && (
          !request.resource.data.isAnonymous 
          || (
            request.resource.data.anonymousNickname is string 
            && request.resource.data.anonymousNickname.size() >= 3 
            && request.resource.data.anonymousNickname.size() <= 20
            && request.resource.data.anonymousNickname.matches('^[a-zA-Z0-9_\\-]+$')
          )
        );

      // Account Update Security:
      // - Only the owner can edit their profile
      // - Prevents privilege escalation (role cannot be changed unless caller is Creator)
      // - Caller cannot change account ID
      allow update: if isOwner(userId)
        && request.resource.data.id == userId
        && (request.resource.data.role == resource.data.role || isCreator())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'id', 'name', 'email', 'avatarBase64', 'isAnonymous',
          'anonymousNickname', 'anonymousNicknameLower', 'schoolId',
          'schoolName', 'role', 'bio', 'year', 'createdAt', 'lastSchoolSwitchedAt'
        ])
        && isValidString(request.resource.data.name, 1, 100)
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.avatarBase64 is string
        && request.resource.data.avatarBase64.size() <= 2621440
        && (
          request.resource.data.schoolId == resource.data.schoolId
          || isCreator()
          || (
            isApprovedSchool(request.resource.data.schoolId)
            && get(/databases/$(database)/documents/schools/$(request.resource.data.schoolId)).data.name == request.resource.data.schoolName
          )
        )
        && request.resource.data.isAnonymous is bool
        && (
          !request.resource.data.isAnonymous 
          || (
            request.resource.data.anonymousNickname is string 
            && request.resource.data.anonymousNickname.size() >= 3 
            && request.resource.data.anonymousNickname.size() <= 20
            && request.resource.data.anonymousNickname.matches('^[a-zA-Z0-9_\\-]+$')
          )
        );

      // Only account owner or Creator can delete account
      allow delete: if isOwner(userId) || isCreator();
    }

    // =========================================================================
    // 2. SCHOOLS COLLECTION
    // Governance Shield: Only the Creator can approve or decline campus affiliations
    // =========================================================================
    match /schools/{schoolId} {
      allow read: if true;

      // New school submissions MUST start in "pending" status (unless Creator)
      allow create: if isSignedIn()
        && isValidString(request.resource.data.name, 1, 120)
        && (
          (request.resource.data.status == "pending" && request.resource.data.submittedByUserId == request.auth.uid)
          || isCreator()
        );

      // School Approvals & Updates:
      // - Only Creator has authority to approve or decline schools
      // - Regular scholars can only increment studentCount or postCount
      allow update: if isCreator();

      // Deletion strictly reserved for the Creator
      allow delete: if isCreator();
    }

    // =========================================================================
    // 3. POSTS COLLECTION
    // Anti-Spam, Payload Caps, and Compelled Identity Protection
    // =========================================================================
    match /posts/{postId} {
      allow read: if true;

      // - Creation Fortress:
      // - Must authenticate with real UID
      // - Image is optional (can post text-only or photo + text); if present, capped at 2.5MB
      // - Caption length capped at 1500 characters to prevent buffer attacks
      // - Caption can be empty if an image is provided
      // - Tag must strictly match the authorized categories
      // - COMPELLED ENFORCEMENT: When isAnonymous == true, identity fields (authorYear, authorBio)
      //   are strictly forbidden from being attached, preventing identity leaks even via raw API scripts
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && (
          isCreator()
          || (
            userBelongsToSchool(request.resource.data.schoolId)
            && isApprovedSchool(request.resource.data.schoolId)
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolName == request.resource.data.schoolName
          )
        )
        && (
          !('imageBase64' in request.resource.data)
          || request.resource.data.imageBase64 == null
          || (request.resource.data.imageBase64 is string && request.resource.data.imageBase64.size() <= 2621440)
        )
        && (
          !('caption' in request.resource.data)
          || request.resource.data.caption == null
          || (request.resource.data.caption is string && request.resource.data.caption.size() <= 1500)
        )
        && isValidTag(request.resource.data.tag)
        && isValidString(request.resource.data.schoolId, 1, 100)
        && isValidString(request.resource.data.schoolName, 1, 120)
        && request.resource.data.isAnonymous is bool
        && (
          !request.resource.data.isAnonymous
          || (
            !('authorYear' in request.resource.data) 
            && !('authorBio' in request.resource.data)
          )
        );

      // Post Updates:
      // - Author can edit their own post
      // - Other authenticated scholars can only submit reactions and comments
      allow update: if isSignedIn() && (
        (
          resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption', 'tag', 'imageBase64'])
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'userReactions'])
          && request.resource.data.reactions is map
          && request.resource.data.userReactions is map
          && request.resource.data.comments == resource.data.comments
          && request.resource.data.userReactions.diff(resource.data.userReactions).affectedKeys().hasOnly([request.auth.uid])
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments'])
          && request.resource.data.comments is list
          && request.resource.data.comments.size() == resource.data.comments.size() + 1
          && request.resource.data.comments.size() <= 500
          && request.resource.data.comments[resource.data.comments.size()].userId == request.auth.uid
          && request.resource.data.comments[resource.data.comments.size()].text is string
          && request.resource.data.comments[resource.data.comments.size()].text.size() >= 1
          && request.resource.data.comments[resource.data.comments.size()].text.size() <= 500
        )
        || isCreator()
      );

      // Deletion: Author or Creator only
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isCreator());
    }
  }
}
